# Copie este arquivo para ".env.local" e preencha com os valores do seu
# projeto Supabase (Project Settings > API no painel do Supabase).
# Enquanto estas variáveis não existirem, o app roda com dados mockados
# localmente (ver src/lib/supabaseClient.ts e src/contexts/AgendaContext.tsx).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica
